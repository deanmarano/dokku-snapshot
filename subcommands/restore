#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$PLUGIN_BASE_PATH/functions"

[[ "${1:-}" == snapshot:* ]] && shift

# Parse arguments
APP=""
SNAPSHOT_ID=""
FORCE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force|-f)
      FORCE=true
      shift
      ;;
    -*)
      echo "!     Unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$APP" ]]; then
        APP="$1"
      elif [[ -z "$SNAPSHOT_ID" ]]; then
        SNAPSHOT_ID="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$APP" || -z "$SNAPSHOT_ID" ]]; then
  echo "Usage: dokku snapshot:restore <app> <snapshot-id> [--force]" >&2
  exit 1
fi

# Verify app exists
if ! "$DOKKU_BIN" apps:exists "$APP" 2>/dev/null; then
  echo "!     App $APP does not exist" >&2
  exit 1
fi

SNAPSHOT_DIR="$PLUGIN_DATA_ROOT/$APP/$SNAPSHOT_ID"

if [[ ! -d "$SNAPSHOT_DIR" ]]; then
  echo "!     Snapshot $SNAPSHOT_ID not found for app $APP" >&2
  exit 1
fi

if [[ "$FORCE" != "true" ]]; then
  echo "!     Restore will overwrite current app data." >&2
  echo "       Run with --force to confirm." >&2
  exit 1
fi

echo "-----> Restoring $APP from snapshot $SNAPSHOT_ID"

# Restore service data
if [[ -d "$SNAPSHOT_DIR/services" ]]; then
  for svc_type_dir in "$SNAPSHOT_DIR/services"/*/; do
    [[ -d "$svc_type_dir" ]] || continue
    svc_type=$(basename "$svc_type_dir")

    # Collect unique service names from both .dump and .info files
    local_svc_names=()
    for svc_file in "$svc_type_dir"*.dump "$svc_type_dir"*.info; do
      [[ -f "$svc_file" ]] || continue
      fname=$(basename "$svc_file")
      sname="${fname%.*}"
      # Add if not already in list
      already=false
      for existing in "${local_svc_names[@]:-}"; do
        [[ "$existing" == "$sname" ]] && already=true && break
      done
      [[ "$already" == "false" ]] && local_svc_names+=("$sname")
    done

    for svc_name in "${local_svc_names[@]:-}"; do
      [[ -z "$svc_name" ]] && continue
      echo "       Restoring $svc_type service: $svc_name"

      # Show version info from .info file if available
      info_file="$svc_type_dir$svc_name.info"
      if [[ -f "$info_file" ]]; then
        snapshot_svc_version=$(grep -oP 'Version:\s*\K.*' "$info_file" | tr -d ' ') || true
        if [[ -n "$snapshot_svc_version" ]]; then
          echo "       Snapshot version: $snapshot_svc_version"
          current_svc_version=$("$DOKKU_BIN" "$svc_type:info" "$svc_name" 2>/dev/null | grep -oP 'Version:\s*\K.*' | tr -d ' ') || true
          if [[ -n "$current_svc_version" && "$snapshot_svc_version" != "$current_svc_version" ]]; then
            echo "!      Warning: Current $svc_type version ($current_svc_version) differs from snapshot ($snapshot_svc_version)"
          fi
        fi
      fi

      # Import data if dump file exists
      dump_file="$svc_type_dir$svc_name.dump"
      if [[ -f "$dump_file" ]]; then
        echo "       Importing $svc_type service: $svc_name"
        import_service "$svc_type" "$svc_name" "$dump_file" || true
      fi
    done
  done
fi

# Restore volumes
if [[ -d "$SNAPSHOT_DIR/volumes" && -f "$SNAPSHOT_DIR/volumes/manifest.txt" ]]; then
  while IFS='=' read -r tar_name host_path; do
    [[ -z "$tar_name" || -z "$host_path" ]] && continue
    tar_file="$SNAPSHOT_DIR/volumes/$tar_name"
    if [[ ! -f "$tar_file" ]]; then
      echo "!      Warning: Volume archive not found: $tar_name" >&2
      continue
    fi

    echo "       Restoring volume: $host_path"
    mkdir -p "$host_path"
    tar xzf "$tar_file" -C "$host_path" 2>/dev/null || {
      echo "!      Warning: Failed to restore volume $host_path" >&2
      continue
    }
  done < "$SNAPSHOT_DIR/volumes/manifest.txt"
fi

echo "-----> Restore complete"
