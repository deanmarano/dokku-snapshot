#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE/config"

[[ "${1:-}" == snapshot:* ]] && shift

# Parse arguments
PROVIDER_NAME=""
PROVIDER_TYPE=""
declare -a CONFIG_PAIRS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)
      PROVIDER_TYPE="$2"
      shift 2
      ;;
    --*)
      KEY="${1#--}"
      KEY=$(echo "$KEY" | tr '[:lower:]-' '[:upper:]_')
      CONFIG_PAIRS+=("$KEY=$2")
      shift 2
      ;;
    -*)
      echo "!     Unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$PROVIDER_NAME" ]]; then
        PROVIDER_NAME="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$PROVIDER_NAME" || -z "$PROVIDER_TYPE" ]]; then
  echo "Usage: dokku snapshot:provider:add <name> --type <type> [--key value ...]" >&2
  exit 1
fi

VALID_TYPES="file s3 gcs azure b2 rsync scp ftp smb"
if [[ " $VALID_TYPES " != *" $PROVIDER_TYPE "* ]]; then
  echo "!     Invalid provider type '$PROVIDER_TYPE'. Valid types: $VALID_TYPES" >&2
  exit 1
fi

PROVIDER_DIR="$PLUGIN_DATA_ROOT/.providers/$PROVIDER_NAME"
if [[ -d "$PROVIDER_DIR" ]]; then
  echo "!     Provider '$PROVIDER_NAME' already exists" >&2
  exit 1
fi

mkdir -p "$PROVIDER_DIR"

{
  echo "TYPE=$PROVIDER_TYPE"
  for pair in "${CONFIG_PAIRS[@]}"; do
    echo "$pair"
  done
} > "$PROVIDER_DIR/config"

echo "-----> Provider '$PROVIDER_NAME' created (type: $PROVIDER_TYPE)"
