#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE/config"
source "$PLUGIN_BASE/functions"

[[ "${1:-}" == snapshot:* ]] && shift

# Parse arguments
APP=""
SNAPSHOT_ID=""
PASSWORD=""
OUTPUT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --password)
      PASSWORD="$2"
      shift 2
      ;;
    --output)
      OUTPUT="$2"
      shift 2
      ;;
    -*)
      echo "!     Unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$APP" ]]; then
        APP="$1"
      elif [[ -z "$SNAPSHOT_ID" ]]; then
        SNAPSHOT_ID="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$APP" || -z "$SNAPSHOT_ID" ]]; then
  echo "Usage: dokku snapshot:export <app> <snapshot-id> --password <pw> [--output <path>]" >&2
  exit 1
fi

# Password from flag or env var
PASSWORD="${PASSWORD:-${SNAPSHOT_PASSWORD:-}}"
if [[ -z "$PASSWORD" ]]; then
  echo "!     Password is required. Use --password <pw> or set SNAPSHOT_PASSWORD env var." >&2
  exit 1
fi

SNAPSHOT_DIR="$PLUGIN_DATA_ROOT/$APP/$SNAPSHOT_ID"

if [[ ! -d "$SNAPSHOT_DIR" ]]; then
  echo "!     Snapshot $SNAPSHOT_ID not found for app $APP" >&2
  exit 1
fi

OUTPUT="${OUTPUT:-$APP-$SNAPSHOT_ID.tar.gz.enc}"

echo "-----> Exporting snapshot $SNAPSHOT_ID of $APP"
encrypt_to_file "$SNAPSHOT_DIR" "$OUTPUT" "$PASSWORD"
echo "       Exported to $OUTPUT"
