#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE/config"

[[ "${1:-}" == snapshot:* ]] && shift

PROVIDER_NAME="${1:-}"

if [[ -z "$PROVIDER_NAME" ]]; then
  echo "Usage: dokku snapshot:provider:delete <name>" >&2
  exit 1
fi

PROVIDER_DIR="$PLUGIN_DATA_ROOT/.providers/$PROVIDER_NAME"
if [[ ! -d "$PROVIDER_DIR" ]]; then
  echo "!     Provider '$PROVIDER_NAME' not found" >&2
  exit 1
fi

rm -rf "$PROVIDER_DIR"
echo "-----> Provider '$PROVIDER_NAME' deleted"
