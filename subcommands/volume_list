#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$PLUGIN_BASE_PATH/functions"

[[ "${1:-}" == snapshot:* ]] && shift

APP="$1"

if [[ -z "$APP" ]]; then
  echo "Usage: dokku snapshot:volume:list <app>" >&2
  exit 1
fi

# Verify app exists
if ! "$DOKKU_BIN" apps:exists "$APP" 2>/dev/null; then
  echo "!     App $APP does not exist" >&2
  exit 1
fi

EXCLUDED_FILE="$PLUGIN_DATA_ROOT/$APP/.excluded-volumes"

mapfile -t all_mounts < <(get_storage_host_paths "$APP")

echo "-----> Volumes for $APP"
if [[ ${#all_mounts[@]} -eq 0 ]]; then
  echo "       (none)"
  exit 0
fi

for host_path in "${all_mounts[@]}"; do
  if [[ -f "$EXCLUDED_FILE" ]] && grep -qxF "$host_path" "$EXCLUDED_FILE" 2>/dev/null; then
    echo "       $host_path  [excluded]"
  else
    echo "       $host_path  [included]"
  fi
done
