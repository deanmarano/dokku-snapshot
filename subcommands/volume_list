#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"

[[ "${1:-}" == snapshot:* ]] && shift

APP="$1"

if [[ -z "$APP" ]]; then
  echo "Usage: dokku snapshot:volume:list <app>" >&2
  exit 1
fi

# Verify app exists
if ! "$DOKKU_BIN" apps:exists "$APP" 2>/dev/null; then
  echo "!     App $APP does not exist" >&2
  exit 1
fi

EXCLUDED_FILE="$PLUGIN_DATA_ROOT/$APP/.excluded-volumes"
storage_report=$("$DOKKU_BIN" storage:report "$APP" 2>/dev/null) || true

# Collect all unique host paths
all_mounts=()
for phase in "Storage build mounts" "Storage deploy mounts" "Storage run mounts"; do
  mounts_val=$(echo "$storage_report" | grep -oP "${phase}:\s*\K.*" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)
  if [[ -n "$mounts_val" ]]; then
    IFS=',' read -ra mount_pairs <<< "$mounts_val"
    for pair in "${mount_pairs[@]}"; do
      pair=$(echo "$pair" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      [[ -z "$pair" ]] && continue
      host_path="${pair%%:*}"
      [[ -z "$host_path" ]] && continue
      already=false
      for existing in "${all_mounts[@]:-}"; do
        [[ "$existing" == "$host_path" ]] && already=true && break
      done
      [[ "$already" == "false" ]] && all_mounts+=("$host_path")
    done
  fi
done

echo "-----> Volumes for $APP"
if [[ ${#all_mounts[@]} -eq 0 ]]; then
  echo "       (none)"
  exit 0
fi

for host_path in "${all_mounts[@]}"; do
  if [[ -f "$EXCLUDED_FILE" ]] && grep -qxF "$host_path" "$EXCLUDED_FILE" 2>/dev/null; then
    echo "       $host_path  [excluded]"
  else
    echo "       $host_path  [included]"
  fi
done
