#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE/config"
source "$PLUGIN_BASE/functions"

[[ "${1:-}" == snapshot:* ]] && shift

# Parse arguments
APP=""
SNAPSHOT_ID=""
PASSWORD=""
PROVIDER_FLAG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --password)
      PASSWORD="$2"
      shift 2
      ;;
    --provider)
      PROVIDER_FLAG="$2"
      shift 2
      ;;
    -*)
      echo "!     Unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$APP" ]]; then
        APP="$1"
      elif [[ -z "$SNAPSHOT_ID" ]]; then
        SNAPSHOT_ID="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$APP" || -z "$SNAPSHOT_ID" ]]; then
  echo "Usage: dokku snapshot:download <app> <snapshot-id> --password <pw> [--provider <name>]" >&2
  exit 1
fi

PASSWORD="${PASSWORD:-${SNAPSHOT_PASSWORD:-}}"
if [[ -z "$PASSWORD" ]]; then
  echo "!     Password is required. Use --password <pw> or set SNAPSHOT_PASSWORD env var." >&2
  exit 1
fi

PROVIDER_NAME=$(resolve_provider "$APP" "$PROVIDER_FLAG")
load_provider_config "$PROVIDER_NAME"

PROVIDER_TYPE=$(get_provider_type "$PROVIDER_NAME")
PROVIDER_SCRIPT="$PLUGIN_BASE/providers/$PROVIDER_TYPE"
if [[ ! -x "$PROVIDER_SCRIPT" ]]; then
  echo "!     Unknown provider type: $PROVIDER_TYPE" >&2
  exit 1
fi

REMOTE_NAME="${APP}-${SNAPSHOT_ID}.tar.gz.enc"

TEMP_FILE=$(mktemp)
TEMP_DIR=$(mktemp -d)
trap 'rm -f "$TEMP_FILE"; rm -rf "$TEMP_DIR"' EXIT

echo "-----> Downloading from provider '$PROVIDER_NAME' ($PROVIDER_TYPE)"
"$PROVIDER_SCRIPT" download "$REMOTE_NAME" "$TEMP_FILE"

echo "-----> Decrypting and extracting snapshot"
if ! decrypt_from_file "$TEMP_FILE" "$TEMP_DIR" "$PASSWORD"; then
  echo "!     Decryption failed. Wrong password or corrupted file." >&2
  exit 1
fi

# Determine snapshot ID from metadata or use the provided one
RESOLVED_ID="$SNAPSHOT_ID"
if [[ -f "$TEMP_DIR/metadata.json" ]]; then
  META_ID=$(grep -oP '"timestamp"\s*:\s*"\K[^"]+' "$TEMP_DIR/metadata.json" || true)
  [[ -n "$META_ID" ]] && RESOLVED_ID="$META_ID"
fi

SNAPSHOT_DIR="$PLUGIN_DATA_ROOT/$APP/$RESOLVED_ID"
if [[ -d "$SNAPSHOT_DIR" ]]; then
  echo "!     Snapshot $RESOLVED_ID already exists for app $APP" >&2
  exit 1
fi

mkdir -p "$SNAPSHOT_DIR"
mv "$TEMP_DIR"/* "$SNAPSHOT_DIR"/

echo "-----> Downloaded and imported snapshot $RESOLVED_ID for $APP"
