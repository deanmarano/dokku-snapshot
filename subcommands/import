#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE/config"
source "$PLUGIN_BASE/functions"

[[ "${1:-}" == snapshot:* ]] && shift

# Parse arguments
APP=""
FILE=""
PASSWORD=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --password)
      PASSWORD="$2"
      shift 2
      ;;
    -*)
      echo "!     Unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$APP" ]]; then
        APP="$1"
      elif [[ -z "$FILE" ]]; then
        FILE="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$APP" || -z "$FILE" ]]; then
  echo "Usage: dokku snapshot:import <app> <file> --password <pw>" >&2
  exit 1
fi

# Password from flag or env var
PASSWORD="${PASSWORD:-${SNAPSHOT_PASSWORD:-}}"
if [[ -z "$PASSWORD" ]]; then
  echo "!     Password is required. Use --password <pw> or set SNAPSHOT_PASSWORD env var." >&2
  exit 1
fi

if [[ ! -f "$FILE" ]]; then
  echo "!     File not found: $FILE" >&2
  exit 1
fi

# Create temp dir and clean up on exit
TEMP_DIR=$(mktemp -d)
trap 'rm -rf "$TEMP_DIR"' EXIT

echo "-----> Decrypting and extracting snapshot"
if ! decrypt_from_file "$FILE" "$TEMP_DIR" "$PASSWORD"; then
  echo "!     Decryption failed. Wrong password or corrupted file." >&2
  exit 1
fi

# Determine snapshot ID from metadata or generate one
SNAPSHOT_ID=""
if [[ -f "$TEMP_DIR/metadata.json" ]]; then
  SNAPSHOT_ID=$(grep -oP '"timestamp"\s*:\s*"\K[^"]+' "$TEMP_DIR/metadata.json" || true)
fi
if [[ -z "$SNAPSHOT_ID" ]]; then
  SNAPSHOT_ID="imported-$(date +"%Y-%m-%d_%H-%M-%S")"
fi

SNAPSHOT_DIR="$PLUGIN_DATA_ROOT/$APP/$SNAPSHOT_ID"

if [[ -d "$SNAPSHOT_DIR" ]]; then
  echo "!     Snapshot $SNAPSHOT_ID already exists for app $APP" >&2
  exit 1
fi

mkdir -p "$SNAPSHOT_DIR"
mv "$TEMP_DIR"/* "$SNAPSHOT_DIR"/

echo "-----> Imported snapshot $SNAPSHOT_ID for $APP"
