#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$PLUGIN_BASE_PATH/functions"

[[ "${1:-}" == snapshot:* ]] && shift

APP="$1"

if [[ -z "$APP" ]]; then
  echo "Usage: dokku snapshot:create <app>" >&2
  exit 1
fi

# Verify app exists
if ! "$DOKKU_BIN" apps:exists "$APP" 2>/dev/null; then
  echo "!     App $APP does not exist" >&2
  exit 1
fi

TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
SNAPSHOT_DIR="$PLUGIN_DATA_ROOT/$APP/$TIMESTAMP"

echo "-----> Creating snapshot of $APP"

mkdir -p "$SNAPSHOT_DIR/services"

# Metadata
cat > "$SNAPSHOT_DIR/metadata.json" << EOF
{
  "app": "$APP",
  "timestamp": "$TIMESTAMP",
  "dokku_version": "$("$DOKKU_BIN" version 2>/dev/null || echo "unknown")",
  "snapshot_version": "4"
}
EOF

# Detect and export linked services
while read -r svc_type svc_name <&3; do
  [[ -z "$svc_type" || -z "$svc_name" ]] && continue
  echo "       Exporting $svc_type service: $svc_name"
  mkdir -p "$SNAPSHOT_DIR/services/$svc_type"
  export_service_info "$svc_type" "$svc_name" "$SNAPSHOT_DIR/services/$svc_type/$svc_name.info"
  export_service "$svc_type" "$svc_name" "$SNAPSHOT_DIR/services/$svc_type/$svc_name.dump" || true
done 3< <(detect_linked_services "$APP") || true

# Backup storage volumes
EXCLUDED_FILE="$PLUGIN_DATA_ROOT/$APP/.excluded-volumes"

# Collect all mount host paths
mapfile -t all_mounts < <(get_storage_host_paths "$APP")

if [[ ${#all_mounts[@]} -gt 0 ]]; then
  mkdir -p "$SNAPSHOT_DIR/volumes"
  : > "$SNAPSHOT_DIR/volumes/manifest.txt"

  for host_path in "${all_mounts[@]}"; do
    # Check exclusion list
    if [[ -f "$EXCLUDED_FILE" ]] && grep -qxF "$host_path" "$EXCLUDED_FILE" 2>/dev/null; then
      echo "       Skipping excluded volume: $host_path"
      continue
    fi

    if [[ ! -e "$host_path" ]]; then
      echo "       Skipping missing volume: $host_path"
      continue
    fi

    # Sanitize path for filename: replace / with -
    sanitized=$(echo "$host_path" | sed 's|^/||;s|/|-|g')
    tar_file="$SNAPSHOT_DIR/volumes/${sanitized}.tar.gz"

    echo "       Backing up volume: $host_path"
    if [[ -d "$host_path" ]]; then
      tar_args=(-C "$host_path" .)
    else
      # single-file volume (e.g. a mounted config file)
      tar_args=(-C "$(dirname "$host_path")" "$(basename "$host_path")")
    fi
    tar_err=$(mktemp)
    set +e
    tar czf "$tar_file" "${tar_args[@]}" 2>"$tar_err"
    tar_rc=$?
    set -e
    if [[ $tar_rc -eq 1 ]]; then
      # exit 1 = "file changed as we read it" etc.; archive is still valid
      echo "       Note: volume changed during backup (archive kept): $host_path"
    elif [[ $tar_rc -ne 0 ]]; then
      echo "!      Warning: Failed to backup volume $host_path" >&2
      sed 's/^/!        /' "$tar_err" | head -3 >&2
      rm -f "$tar_file" "$tar_err"
      continue
    fi
    rm -f "$tar_err"
    echo "${sanitized}.tar.gz=$host_path" >> "$SNAPSHOT_DIR/volumes/manifest.txt"
  done
fi

echo "-----> Snapshot created: $TIMESTAMP"
echo "       Location: $SNAPSHOT_DIR"
