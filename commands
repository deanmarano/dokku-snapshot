#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$PLUGIN_BASE_PATH/config"

[[ " snapshot:help snapshot " == *" $1 "* ]] || [[ "$1" == "snapshot:"* ]] || exit "$DOKKU_NOT_IMPLEMENTED_EXIT"

show_help() {
  cat << EOF
usage: dokku snapshot[:COMMAND]

Snapshot and restore entire dokku app stacks.

dokku snapshot commands:

    snapshot:create <app>                          create a snapshot of an app
    snapshot:inspect <app>                         show all current config for an app
    snapshot:list <app>                            list snapshots for an app
    snapshot:restore <app> <snapshot-id> [--force]  restore an app from a snapshot
EOF
}

case "$1" in
  snapshot|snapshot:help)
    show_help
    ;;
  snapshot:*)
    subcommand="${1#snapshot:}"
    shift

    normalized_subcommand="${subcommand//:/_}"
    normalized_subcommand="${normalized_subcommand//-/_}"
    subcommand_file="$PLUGIN_BASE_PATH/subcommands/$normalized_subcommand"

    if [[ -x "$subcommand_file" ]]; then
      exec "$subcommand_file" "$@"
    else
      echo "Unknown command: snapshot:$subcommand" >&2
      echo "Run 'dokku snapshot:help' for usage" >&2
      exit 1
    fi
    ;;
  *)
    exit "$DOKKU_NOT_IMPLEMENTED_EXIT"
    ;;
esac
