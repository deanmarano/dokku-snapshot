#!/usr/bin/env bash

# Parse a field value from a Dokku report file.
# Usage: parse_report_field <file> <field-name>
# Example: parse_report_field proxy.txt "Proxy type" -> "nginx"
parse_report_field() {
  local file="$1" field="$2"
  grep -oP "${field}:\s*\K.*" "$file" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true
}

# Detect linked services by listing all services and checking linkage.
# Outputs lines of: <type> <service-name>
detect_linked_services() {
  local APP="$1"
  local SERVICE_TYPES=("postgres" "redis" "mysql" "mongo" "mariadb" "memcached")

  for svc_type in "${SERVICE_TYPES[@]}"; do
    # Check if the plugin is installed
    if ! "$DOKKU_BIN" "$svc_type:list" &>/dev/null; then
      continue
    fi

    # Capture service list into a variable to avoid piping into while-read,
    # which would steal stdin from commands inside the loop (breaks basher).
    local svc_list
    svc_list=$("$DOKKU_BIN" "$svc_type:list" 2>/dev/null | tail -n +2) || true

    while read -r name _rest; do
      [[ -z "$name" ]] && continue
      if "$DOKKU_BIN" "$svc_type:linked" "$name" "$APP" &>/dev/null; then
        echo "$svc_type $name"
      fi
    done <<< "$svc_list"
  done
}

# Export a service's data to a file
export_service() {
  local TYPE="$1"
  local NAME="$2"
  local OUTPUT_FILE="$3"

  if "$DOKKU_BIN" "$TYPE:export" "$NAME" > "$OUTPUT_FILE" 2>/dev/null; then
    return 0
  else
    echo "!     Warning: Failed to export $TYPE service $NAME" >&2
    rm -f "$OUTPUT_FILE"
    return 1
  fi
}

# Export a service's info/metadata to a file
export_service_info() {
  local TYPE="$1"
  local NAME="$2"
  local OUTPUT_FILE="$3"
  "$DOKKU_BIN" "$TYPE:info" "$NAME" > "$OUTPUT_FILE" 2>/dev/null || true
}

# Import service data from a file
import_service() {
  local TYPE="$1"
  local NAME="$2"
  local INPUT_FILE="$3"

  if "$DOKKU_BIN" "$TYPE:import" "$NAME" < "$INPUT_FILE" 2>/dev/null; then
    return 0
  else
    echo "!     Warning: Failed to import $TYPE service $NAME" >&2
    return 1
  fi
}

# --- Provider helpers ---

# Load provider config and export as env vars.
# The PATH key is exported as PATH_DIR to avoid clobbering the system PATH.
load_provider_config() {
  local PROVIDER_NAME="$1"
  local PROVIDER_DIR="$PLUGIN_DATA_ROOT/.providers/$PROVIDER_NAME"
  local CONFIG_FILE="$PROVIDER_DIR/config"

  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "!     Provider '$PROVIDER_NAME' not found" >&2
    return 1
  fi

  while IFS='=' read -r key value; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    if [[ "$key" == "PATH" ]]; then
      export PATH_DIR="$value"
    else
      export "$key=$value"
    fi
  done < "$CONFIG_FILE"
}

# Resolve which provider to use: --provider flag > app default > error
resolve_provider() {
  local APP="$1"
  local FLAG_PROVIDER="${2:-}"

  if [[ -n "$FLAG_PROVIDER" ]]; then
    echo "$FLAG_PROVIDER"
    return 0
  fi

  local DEFAULT_FILE="$PLUGIN_DATA_ROOT/$APP/.provider"
  if [[ -f "$DEFAULT_FILE" ]]; then
    cat "$DEFAULT_FILE"
    return 0
  fi

  echo "!     No provider specified. Use --provider <name> or set a default with snapshot:provider:set-default" >&2
  return 1
}

# Get provider type from config
get_provider_type() {
  local PROVIDER_NAME="$1"
  local CONFIG_FILE="$PLUGIN_DATA_ROOT/.providers/$PROVIDER_NAME/config"
  grep '^TYPE=' "$CONFIG_FILE" 2>/dev/null | cut -d= -f2-
}

# Encrypt a snapshot directory to a file
encrypt_to_file() {
  local SNAPSHOT_DIR="$1"
  local OUTPUT_FILE="$2"
  local PASSWORD="$3"
  tar czf - -C "$SNAPSHOT_DIR" . | openssl enc -aes-256-cbc -pbkdf2 -salt -pass "pass:$PASSWORD" -out "$OUTPUT_FILE"
}

# Decrypt a file to a directory
decrypt_from_file() {
  local INPUT_FILE="$1"
  local OUTPUT_DIR="$2"
  local PASSWORD="$3"
  openssl enc -d -aes-256-cbc -pbkdf2 -salt -pass "pass:$PASSWORD" -in "$INPUT_FILE" | tar xzf - -C "$OUTPUT_DIR"
}
